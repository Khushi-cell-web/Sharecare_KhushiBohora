# ShareCare Flutter - Copy to .env and fill in your values
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Port must match Django (e.g. Postman http://127.0.0.1:8000 → same :8000 here; if you use runserver 8080, set :8080).
# auto → desktop localhost; Android emulator 10.0.2.2; physical phone uses API_LAN_FALLBACK_BASE_URL
# Wi‑Fi only: API_BASE_URL=http://YOUR_PC_LAN_IP:8000 and runserver 0.0.0.0:8000
# API_BASE_URL=http://192.168.1.5:8000
API_BASE_URL=auto

# Used when API_BASE_URL=auto on physical Android.
API_LAN_FALLBACK_BASE_URL=http://192.168.1.5:8000

# Google Sign-In (Android): Web/server OAuth client ID.
# Example: 1234567890-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com
GOOGLE_SERVER_CLIENT_ID=
