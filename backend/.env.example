# ShareCare Backend - Environment Variables
# Copy to .env and fill in your values

# SQLite by default. For PostgreSQL, uncomment and set:
# DB_ENGINE=postgres
# DB_NAME=sharecare
# DB_USER=sharecare
# DB_PASSWORD=your_password
# DB_HOST=localhost
# DB_PORT=5432

SECRET_KEY=your-secret-key-change-in-production

# Email (SMTP) - required for sending real emails
# When EMAIL_HOST, EMAIL_HOST_USER, EMAIL_HOST_PASSWORD are set, emails are sent to users.
# Otherwise emails are printed to console (dev mode).
DEFAULT_FROM_EMAIL=noreply@sharecare.local
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your-email@gmail.com
# Gmail: use App Password (Google Account > Security > 2-Step Verification > App passwords)
# Outlook: smtp.office365.com, port 587
EMAIL_HOST_PASSWORD=your-app-password

# Stripe (for real payments)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# Frontend: set STRIPE_PUBLISHABLE_KEY (pk_test_...) in Flutter ApiConstants

# eSewa (Nepal payment gateway). Amount in NPR.
# UAT secret: 8gBm/:&EnhH.1/q  |  Prod: from eSewa merchant
ESEWA_SECRET_KEY=
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_ENVIRONMENT=uat
# eSewa redirect base URL. It must be reachable by the device.
# Try: http://10.0.2.2:8000 (emulator), http://YOUR_PC_LAN_IP:8000 (physical phone on Wi-Fi).
# Run Django: python manage.py runserver 0.0.0.0:8000
ESEWA_REDIRECT_BASE_URL=

# Firebase (for push notifications). Path to service account JSON.
# Example: D:\FYP Sharecare\backend\firebase-service-account.json
FIREBASE_CREDENTIALS=path/to/firebase-service-account.json
